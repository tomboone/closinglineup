# Copy to ~/.config/closinglineup-backup.env (mode 600) on kumadrome and fill in. Not committed.

MOUNT_POINT=/mnt/music
# Where the dumps are kept on the USB drive (README, step 9).
BACKUP_DIR=/mnt/music/closinglineup/backups
# Days of dumps kept in BACKUP_DIR, and so on B2.
KEEP_DAYS=14

# rclone destination, in the bucket the Navidrome backup uses. The remote name ("b2") is the one in
# tom's rclone.conf.
REMOTE=b2:<bucket>/closinglineup-backups

# Optional: the push URL of the kumadrome/closinglineup-backup push monitor on the personal Kuma
# (heartbeat interval 25 h). Keep the double quotes: this file is sourced, and an unquoted & (Kuma's
# default "?status=up&msg=OK&ping=" query) sends the assignment to the background, leaving PING_URL
# unset and the ping silently skipped. The query itself is dropped by the script either way.
PING_URL="http://127.0.0.1:3002/api/push/<token>"
