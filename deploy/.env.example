# Copy to .env next to docker-compose.yml and fill in. .env is not committed. Every app setting and
# its default is in the project spec, §10; only what kumadrome needs is listed here.

# The Postgres password, also used to build DATABASE_URL. URL-safe characters only, e.g. the output
# of `openssl rand -hex 24`.
POSTGRES_PASSWORD=

# On the USB drive mounted at /mnt/music (README, step 2).
DATA_HOST_DIR=/mnt/music/closinglineup/data
PG_HOST_DIR=/mnt/music/closinglineup/pg

# The loopback port the API and UI are published on. Not 8000, which weekly-movie-theater-email
# holds on kumadrome.
APP_PORT=8010

# healthchecks.io ping URLs, one per job family (README, step 3). Unset → no ping.
HEALTHCHECKS_URL_NIGHTLY=
HEALTHCHECKS_URL_DAILY=
HEALTHCHECKS_URL_WEEKLY=

TZ=America/New_York
LOG_LEVEL=INFO
